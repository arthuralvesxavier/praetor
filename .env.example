# Copie para .env e ajuste. NUNCA versione o arquivo .env.

# PostgreSQL. O padrão aponta para o servidor embarcado de desenvolvimento (npm run db:dev).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/praetor

APP_URL=http://localhost:3000

# Armazenamento local de arquivos enviados (fora de /public; acesso apenas por rota autenticada).
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20
SESSION_TTL_HOURS=12

# Provedor de IA: auto | anthropic | demo
#  auto      -> usa Anthropic se ANTHROPIC_API_KEY estiver definida; caso contrário, modo demonstrativo
#  demo      -> sempre modo demonstrativo (resultados claramente identificados, sem IA real)
#  anthropic -> exige credenciais válidas da Anthropic
AI_PROVIDER=auto
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_MAX_OUTPUT_TOKENS=16000

WORKER_POLL_INTERVAL_MS=3000
LOG_LEVEL=info

# Acompanhamento automático na API pública do DataJud (CNJ).
# A chave é PÚBLICA, publicada pelo CNJ em https://datajud-wiki.cnj.jus.br/api-publica/acesso,
# e pode ser trocada pelo CNJ a qualquer momento. Sem ela a coleta fica inativa (nada quebra).
# Valor esperado: só a chave (sem o prefixo "APIKey ").
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
# Tempo limite de cada consulta (as consultas costumam levar de 7 a 25 s).
DATAJUD_TIMEOUT_MS=60000

# Painéis Power BI (passo a passo em docs/POWER_BI.md). Aplicativo registrado no Microsoft Entra ID
# (service principal) com acesso ao workspace. Sem estas três variáveis a tela /paineis-bi mostra
# as instruções de configuração e nenhuma atualização é solicitada (nada quebra).
# O segredo fica SOMENTE aqui: nunca no banco, em logs ou na tela.
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_API_URL=https://api.powerbi.com
POWERBI_AUTHORITY_URL=https://login.microsoftonline.com
# Senha do usuário de banco somente leitura "praetor_bi" (criado por `npx tsx scripts/bi-setup.ts`).
BI_DB_PASSWORD=

# Somente para scripts/demo-api-push.ts (sistema externo de demonstração enviando um processo fictício):
# PRAETOR_API_KEY=prt_...
# PRAETOR_API_URL=http://localhost:3000

# Somente para `npm run db:seed` (dados fictícios de demonstração — nunca em produção):
#  SEED_USE_LIVE_AI=true  -> o seed usa o provedor de IA configurado acima (padrão: sempre modo demonstrativo, sem custo)
#  SEED_LOG_LEVEL=info    -> nível de log durante o seed (padrão: warn)
# SEED_USE_LIVE_AI=false
# SEED_LOG_LEVEL=warn
